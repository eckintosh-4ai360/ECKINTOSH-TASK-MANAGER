# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=""
DIRECT_URL=""
DATABASE_URL_UNPOOLED=""

# Database TLS. Certificates are verified by default. Managed providers (Neon,
# Supabase, RDS) work as-is. For a private CA, set DATABASE_CA_CERT to the PEM
# contents or DATABASE_CA_CERT_PATH to the file. DATABASE_SSL_NO_VERIFY=true is
# a local-development escape hatch and is refused in production.
# DATABASE_CA_CERT=""
# DATABASE_SSL_NO_VERIFY="false"

# ─── Session / auth ──────────────────────────────────────────────────────────
# REQUIRED. At least 32 characters. Generate with: openssl rand -base64 32
# The app refuses to boot in production without this.
JWT_SECRET=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

GITHUB_ID=""
GITHUB_SECRET=""

# OAuth scopes. "repo" lets each user's own token perform repository writes, so
# commits and merges are attributed to the person who made them. Drop it if this
# deployment never writes to GitHub.
# GITHUB_OAUTH_SCOPES="read:user user:email repo"

# ─── Who may sign in ─────────────────────────────────────────────────────────
# Registration is CLOSED by default: an admin creates the user first (Admin →
# Users), then that person signs in with GitHub and the accounts link by email.
# The very first account to sign in to an empty workspace becomes its admin.
# SIGNUP_ALLOWED_DOMAINS="yourcompany.com"
# SIGNUP_ALLOWED_EMAILS="contractor@partner.com"
# SIGNUP_MODE="open"   # disables the gate entirely — not recommended

# Optional. Encrypts SMTP passwords stored in the database. Defaults to being
# derived from the session secret above — set this only if you want the two to
# rotate independently.
# SECRETS_ENCRYPTION_KEY=""

# ─── AI ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=""

# ─── Uploads & Cloud Storage ────────────────────────────────────────────────
# For Vercel deployments, add BLOB_READ_WRITE_TOKEN from Vercel Blob Store.
# When unset, uploads fall back to local disk storage in MEDIA_STORAGE_DIR.
# BLOB_READ_WRITE_TOKEN=""
# MEDIA_STORAGE_DIR="./storage/uploads"

# ─── Realtime Messaging & Presence (Pusher) ──────────────────────────────────
# Required for serverless real-time messaging, editing, deletions, and presence.
# Create a free app at pusher.com (Channels).
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# ─── Push notifications ──────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@example.com"

# ─── Outbound email (optional) ───────────────────────────────────────────────
# Preferred setup is Settings → Email Delivery in the app, where an admin enters
# Gmail or SMTP credentials that are stored encrypted in the database.
# These variables are only a fallback for deployments that prefer env config;
# anything saved in the app overrides them.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFICATION_FROM_EMAIL=""
NOTIFICATION_FROM_NAME="Spagad Notifications"

# ─── GitHub workspace integration ────────────────────────────────────────────
# Shared fallback token, used for READS only by default. Repository writes use
# each user's own OAuth token so they are attributable.
GITHUB_ACCESS_TOKEN=""
# Set to "true" to let the shared token perform writes as well. Everyone's
# commits then come from this one account — off unless you need it.
# GITHUB_ALLOW_SHARED_WRITE_TOKEN="false"
# REQUIRED for /api/github/webhook. Without it the endpoint rejects every
# delivery rather than trusting unsigned payloads.
GITHUB_WEBHOOK_SECRET=""

# ─── Reminder scheduler ──────────────────────────────────────────────────────
# REQUIRED for /api/cron/reminders (task reminders, overdue escalation, daily
# digests). Generate with: openssl rand -base64 32
# On Vercel, set this env var and Vercel automatically sends it as
# `Authorization: Bearer $CRON_SECRET` to the schedule declared in vercel.json.
# Note: sub-daily cron schedules (this one runs every 15 min) require a Vercel
# Pro plan — Hobby is limited to once/day. On Hobby, either upgrade or edit
CRON_SECRET=""
